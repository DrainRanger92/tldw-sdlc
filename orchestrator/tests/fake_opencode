#!/usr/bin/env bash
# Фейк для тестов: печатает маркер роли и аргументы; режимы через FAKE_MODE.
if [ "$1" = "--version" ]; then echo "9.9.9-fake"; exit 0; fi
case "${FAKE_MODE:-ok}" in
  ok)   echo "FAKE[$*]"; exit 0 ;;
  fail) echo "boom" >&2; exit 1 ;;
  json)
    echo '{"type":"text","sessionID":"ses_fake123","part":{"type":"text","text":"привет от агента"}}'
    echo '{"type":"step_finish","sessionID":"ses_fake123","part":{"type":"step-finish","tokens":{"total":1500},"cost":0.05}}'
    exit 0 ;;
esac
