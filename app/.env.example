# TLDW — пример конфигурации приложения.
# Скопируйте файл в app/.env и заполните значения. Реальный .env в git не попадает.
# Значения ниже — незаполненные или дефолтные; настоящих секретов здесь нет.

# --- Telegram ---
# Токен бота от @BotFather (обязательно).
TELEGRAM_BOT_TOKEN=
# Telegram user ID, которым разрешён доступ: через запятую или пробел.
# Пустое значение — доступ разрешён всем (в лог пишется предупреждение).
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM ---
# Ключ API провайдера LLM (обязательно, в git не коммитится).
LLM_API_KEY=
# Имя модели LLM для конспекта, например deepseek-chat (обязательно).
LLM_MODEL=
# Базовый URL OpenAI-совместимого API.
LLM_BASE_URL=https://api.deepseek.com
# Таймаут одного запроса к LLM, секунды.
LLM_TIMEOUT_SECONDS=60

# --- Обработка видео ---
# Порог длительности видео в секундах; видео длиннее порога отклоняется.
# По умолчанию 7200 секунд = 2 часа.
VIDEO_MAX_DURATION_SECONDS=7200

# --- Прочее ---
# Каталог готовых заметок, кэша транскриптов и скачанных файлов.
# Относительный путь считается от каталога app/; каталог в .gitignore.
DATA_DIR=data
# Уровень логирования: DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO
